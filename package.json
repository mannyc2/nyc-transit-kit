{
  "name": "nyc-transit-kit",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.6",
      "@effect/vitest": "4.0.6",
      "effect": "4.0.6",
      "gtfs-realtime-bindings": "2.0.0"
    },
    "catalogs": {
      "tooling": {
        "@biomejs/biome": "2.5.0",
        "@types/bun": "1.3.14",
        "typescript": "6.0.3",
        "vitest": "5.0.5"
      }
    }
  },
  "scripts": {
    "prepare": "effect-language-service patch && bun install --cwd tools/release --frozen-lockfile",
    "check": "bun run check:types && bun run check:effect && bun run check:style && bun run test && bun run check:package",
    "check:types": "tsc -p tsconfig.json && tsc -p tsconfig.published.json",
    "check:effect": "effect-language-service diagnostics --project tsconfig.json --format text --strict",
    "check:style": "biome check .",
    "check:style:write": "biome check --write .",
    "check:package": "bun run scripts/check-package-archives.ts",
    "check:provider-coverage": "bun run scripts/check-provider-coverage-set.ts",
    "check:npm-stage": "bun run scripts/check-npm-release-stage.ts",
    "check:release-config": "bun run scripts/check-release-config.ts",
    "check:release-ci": "bun run tools/release/run-ts-release.ts check-ci --config release.config.json --workflow .github/workflows/release.yml",
    "check:release-local": "bun run release:version:check && bun run check && bun run build:cli && bun run release:prepare:npm && bun run check:npm-stage && bun run check:release-config && bun run check:release-ci && bun run release:plan",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "cli": "bun run apps/cli/src/bin.ts",
    "build:cli": "bun run apps/cli/scripts/build.ts",
    "release": "bun run tools/release/run-ts-release.ts",
    "release:version": "bun run scripts/sync-release-version.ts",
    "release:version:check": "bun run scripts/sync-release-version.ts --check",
    "release:prepare:npm": "bun run scripts/prepare-npm-release.ts",
    "release:provider-coverage": "bun run scripts/check-provider-coverage-set.ts --out .release/evidence/provider-coverage.json",
    "release:stage-artifacts": "bun run tools/release/run-ts-release.ts stage-artifacts --config release.config.json --format text",
    "release:plan": "bun run tools/release/run-ts-release.ts plan --config release.config.json --format text",
    "release:plan:json": "bun run tools/release/run-ts-release.ts plan --config release.config.json --format json --out .release/evidence/plan.json",
    "release:doctor": "bun run tools/release/run-ts-release.ts doctor --config release.config.json",
    "release:check-auth": "bun run tools/release/run-ts-release.ts check-auth --config release.config.json",
    "release:check-ci": "bun run tools/release/run-ts-release.ts check-ci --config release.config.json --workflow .github/workflows/release.yml",
    "release:remote-state": "bun run scripts/check-release-remote-state.ts",
    "release:validate": "bun run tools/release/run-ts-release.ts validate --config release.config.json",
    "release:run": "bun run tools/release/run-ts-release.ts run --config release.config.json",
    "release:trust-publishing": "bun run scripts/switch-release-config-to-trusted-publishing.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:tooling",
    "@effect/language-service": "0.87.5",
    "@effect/platform-bun": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:tooling",
    "effect": "catalog:",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@effect/language-service"
  ],
  "packageManager": "bun@1.3.14"
}
